# Local demo credentials only. Change before hosting outside your workstation.
POSTGRES_DB=resolveai
POSTGRES_USER=resolveai
POSTGRES_PASSWORD=resolveai_local
DATABASE_URL=postgresql+psycopg://resolveai:resolveai_local@localhost:5432/resolveai
APP_ENV=development
CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO
# Local demo identity selection. Disable it and supply a private signing key in production.
DEMO_AUTH_ENABLED=true
SESSION_SIGNING_KEY=resolveai-local-demo-key-change-before-hosting
SESSION_TTL_SECONDS=28800
# Explicit offline parser or the live OpenAI adapter. Demo mode makes no LLM calls.
LLM_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=20
# local_hash is a deterministic lexical baseline; OpenAI provides semantic embeddings.
EMBEDDING_PROVIDER=local_hash
EMBEDDING_MODEL=text-embedding-3-small
# The schema currently requires 1536 dimensions; changing it requires a migration.
EMBEDDING_DIMENSIONS=1536
EMBEDDING_TIMEOUT_SECONDS=20
RAG_TOP_K=8
RAG_MIN_SCORE=0.1
# After changing embedding provider/model, run: python -m app.rag.ingest
AGENT_WORKER_ENABLED=true
AGENT_POLL_SECONDS=1
AGENT_LEASE_SECONDS=180
AGENT_MAX_ATTEMPTS=3
CHECKPOINT_SCHEMA=resolveai_checkpoints
# SQLite is an offline test adapter; this path is ignored for PostgreSQL.
# CHECKPOINT_SQLITE_PATH=.local/checkpoints.sqlite
